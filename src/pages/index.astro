---
import { createTarotTable } from "../components/TarotTable.ts";
---

<div id="table"></div>

<script>
  import { createTarotTable } from "../components/TarotTable.ts";

  const table = document.querySelector("#table");

  if (table instanceof HTMLElement) {
    createTarotTable(table);
  }
</script>

<style>
  #table {
    width: 100vw;
    height: 100vh;
  }
</style>